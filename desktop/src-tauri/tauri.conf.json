{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Character Desktop",
  "version": "0.3.0",
  "identifier": "com.localcharacter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local Character Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https:; img-src 'self' asset: https: http: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "shortDescription": "Chat local con personajes, modelos GGUF y servidor local",
    "longDescription": "Aplicación de escritorio local para probar modelos GGUF grandes, conversar con personajes y medir rendimiento.",
    "resources": {
      "../native/bin/*": "native/bin/"
    }
  }
}
